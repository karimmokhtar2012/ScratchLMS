# ScratchLMS Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database driver: sqlite, mysql, or pgsql
DB_DRIVER=sqlite

# -----------------------------------------------------------------------------
# SQLite Configuration (default - no additional setup required)
# -----------------------------------------------------------------------------
# SQLite is the default and requires no additional configuration.
# The database file will be created at: database/database.sqlite
# To use a custom path, uncomment and set:
# DB_DATABASE=/path/to/database.sqlite

# -----------------------------------------------------------------------------
# MySQL Configuration
# -----------------------------------------------------------------------------
# Default port: 3306
# To use MySQL, set DB_DRIVER=mysql and configure:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=scratchlms
# DB_USERNAME=root
# DB_PASSWORD=secret

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
# Default port: 5432 (NOT 8000 - that's typically the PHP dev server!)
# To use PostgreSQL, set DB_DRIVER=pgsql and configure:
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=scratchlms
# DB_USERNAME=postgres
# DB_PASSWORD=secret
# DB_SCHEMA=public

# -----------------------------------------------------------------------------
# Quick Setup Commands
# -----------------------------------------------------------------------------
# SQLite:  No setup needed - just run migrations
#
# MySQL:   mysql -u root -p
#          CREATE DATABASE scratchlms;
#          CREATE USER 'lms_user'@'localhost' IDENTIFIED BY 'your_password';
#          GRANT ALL PRIVILEGES ON scratchlms.* TO 'lms_user'@'localhost';
#
# PostgreSQL (macOS with Homebrew):
#          brew install postgresql@16
#          brew services start postgresql@16
#          createuser -P lms_user   # Creates user with password prompt
#          createdb -O lms_user scratchlms

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application environment: development, staging, production
APP_ENV=development

# Enable debug mode (shows detailed errors - disable in production!)
APP_DEBUG=true

# Application URL (used for generating links)
# Note: This is for your PHP application, separate from DB_PORT
APP_URL=http://localhost:8000

# =============================================================================
# API KEYS (optional)
# =============================================================================

# Groq API Key for AI features
# GROQ_API_KEY=your_groq_api_key_here
