  \cf4    - Create table 'enrollments' (id, user_id, course_id, progress_percent, is_completed).\cf2 \
  \cf4    - Create table 'completed_lessons' (user_id, lesson_id).\cf2 \
  \cf4    - Execute migration and print '\uc0\u9989  Tracking Tables Created'.\cf2 \
\
  \cf4 2. CONTROLLER ('app/Controllers/LearnController.php'):\cf2 \
  \cf4    - Method 'show($course_id, $lesson_id)':\cf2 \
  \cf4      * Verify User is enrolled (if not, redirect or show preview).\cf2 \
  \cf4      * Fetch Course, Current Lesson, and List of all lessons (Playlist).\cf2 \
  \cf4      * Render 'learn/player' view.\cf2 \
  \cf4    - Method 'trackProgress()':\cf2 \
  \cf4      * Accept POST (verb: 'started', 'completed', 'watched_50').\cf2 \
  \cf4      * Log to 'xapi_logs'.\cf2 \
